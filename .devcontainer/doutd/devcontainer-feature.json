{
    "id": "docker-outside-docker-gitpod",
    "version": "1.0.0",
    "options": {
    },
    "entrypoint": "/usr/local/share/docker-init.sh",
    "containerEnv": {
        "DOCKER_BUILDKIT": "1"
    },
    "mounts": [
        {
            "source": "/var/run/docker.sock",
            "target": "/var/run/docker.sock",
            "type": "bind"
        }
    ]
}