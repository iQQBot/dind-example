{
    "id": "docker-in-docker-gitpod",
    "version": "1.0.0",
    "options": {
    },
    "entrypoint": "/usr/local/share/docker-init.sh",
    "privileged": true,
    "containerEnv": {
        "DOCKER_BUILDKIT": "1"
    },
    "mounts": [
        {
            "source": "dind-var-lib-docker-${devcontainerId}",
            "target": "/var/lib/docker",
            "type": "volume"
        }
    ]
}